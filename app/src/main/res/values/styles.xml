<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== MaterialButton 样式 ========== -->

    <!-- 主按钮 -->
    <style name="Widget.LocalDrop.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 轮廓按钮 -->
    <style name="Widget.LocalDrop.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 文本按钮 -->
    <style name="Widget.LocalDrop.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 图标按钮 -->
    <style name="Widget.LocalDrop.Button.IconButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/button_icon_padding</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ========== MaterialCardView 样式 ========== -->

    <!-- 提升卡片 -->
    <style name="Widget.LocalDrop.CardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation_md</item>
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="contentPaddingLeft">@dimen/card_padding_horizontal</item>
        <item name="contentPaddingTop">@dimen/card_padding_vertical</item>
        <item name="contentPaddingRight">@dimen/card_padding_horizontal</item>
        <item name="contentPaddingBottom">@dimen/card_padding_vertical</item>
    </style>

    <!-- 轮廓卡片 -->
    <style name="Widget.LocalDrop.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="contentPaddingLeft">@dimen/card_padding_horizontal</item>
        <item name="contentPaddingTop">@dimen/card_padding_vertical</item>
        <item name="contentPaddingRight">@dimen/card_padding_horizontal</item>
        <item name="contentPaddingBottom">@dimen/card_padding_vertical</item>
    </style>

    <!-- ========== TextInputLayout 样式 ========== -->

    <style name="Widget.LocalDrop.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_sm</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ========== MaterialSwitch 样式 ========== -->

    <style name="Widget.LocalDrop.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">?attr/colorPrimaryContainer</item>
        <item name="thumbTint">?attr/colorPrimary</item>
    </style>

    <!-- ========== TextView 样式 ========== -->

    <!-- 标题样式 -->
    <style name="TextAppearance.LocalDrop.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.LocalDrop.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.LocalDrop.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LocalDrop.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 正文字体 -->
    <style name="TextAppearance.LocalDrop.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.LocalDrop.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.LocalDrop.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ========== 工具栏样式 ========== -->

    <style name="Widget.LocalDrop.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="android:elevation">@dimen/top_app_bar_elevation</item>
    </style>
</resources>
